# Enforce LF for text files across all platforms (Windows, macOS, Linux)
* text=auto eol=lf

# Windows-specific batch scripts
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary file declarations
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.docx binary
*.xlsx binary
*.blob binary
*.db binary
